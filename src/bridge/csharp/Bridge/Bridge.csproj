<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <OutputType>Library</OutputType>
    <AssemblyName>Bridge</AssemblyName>
    <RootNamespace>BridgeLib</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- Needed so get_function_pointer / UnmanagedCallersOnly exports work from a native host -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../../../external/UndertaleModTool/UndertaleModLib/UndertaleModLib.csproj" />
  </ItemGroup>

</Project>